# Copy to backend/.env and change the values.
AG_SUPERADMIN_LOGIN=superadmin
AG_SUPERADMIN_PASSWORD=change-this-first-password
AG_SUPERADMIN_NAME=School Office
# 1 when the site is served over HTTPS (it should be)
AG_COOKIE_SECURE=1
# Optional: where the database and uploads live (default backend/data)
# AG_DATA_DIR=/var/lib/arundhati-gurukulam

# Email / SMTP configuration for OTP & notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=your-email@domain.com
SMTP_FROM_NAME=Arundhati Gurukulam
SMTP_TLS=1

# ---- Hosting on Vercel (set these in Project → Settings → Environment Variables) ----
# Long random string so logins survive across server instances. Required on Vercel.
# AG_SECRET_KEY=
# Postgres connection string; added automatically when you connect a Neon database.
# Without it the app uses SQLite in AG_DATA_DIR (fine on a VPS, wiped often on Vercel).
# DATABASE_URL=
# Added automatically when you connect a Vercel Blob store (choose "public" access).
# Without it uploads are saved in AG_DATA_DIR/uploads.
# BLOB_READ_WRITE_TOKEN=
