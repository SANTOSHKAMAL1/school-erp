# Copy to backend/.env and change the values.
AG_SUPERADMIN_LOGIN=superadmin
AG_SUPERADMIN_PASSWORD=change-this-first-password
AG_SUPERADMIN_NAME=School Office
# 1 when the site is served over HTTPS (it should be)
AG_COOKIE_SECURE=1
# Optional: where the database and uploads live (default backend/data)
# AG_DATA_DIR=/var/lib/arundhati-gurukulam

# Email / SMTP configuration for OTP & notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=your-email@domain.com
SMTP_FROM_NAME=Arundhati Gurukulam
SMTP_TLS=1
