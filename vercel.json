{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": { "root": "frontend/" },
    "backend": { "root": "backend/", "entrypoint": "app.main:app" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/uploads/(.*)", "destination": { "service": "backend" } },
    { "source": "/(login|admissions|contact|mandatory-disclosure|portal)", "destination": { "service": "frontend", "path": "/index.html" } },
    { "source": "/portal/(.*)", "destination": { "service": "frontend", "path": "/index.html" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
